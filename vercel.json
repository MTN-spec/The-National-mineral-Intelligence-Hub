{
  "version": 2,
  "builds": [
    {
      "src": "api.py",
      "use": "@vercel/python"
    },
    {
      "src": "src/dashboard/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api.py"
    },
    {
      "src": "/docs",
      "dest": "api.py"
    },
    {
      "src": "/openapi.json",
      "dest": "api.py"
    },
    {
      "src": "/(.*)",
      "dest": "src/dashboard/$1"
    }
  ]
}
