# ============================================================================
# MTN-SPEC Banking-Grade Secrets Configuration Template
# Copy this file to `.streamlit/secrets.toml` locally (git-ignored) OR
# configure these keys as encrypted Environment Variables in Render / Cloud.
# NEVER commit real passwords, API tokens, or private keys to Git.
# ============================================================================

NMIH_ADMIN_EMAIL = "admin@mtnspec.co.zw"
NMIH_ADMIN_PASSWORD = "REPLACE_WITH_STRONG_ENV_PASSWORD"
NMIH_HMAC_SECRET = "REPLACE_WITH_64_HEX_CHAR_CRYPTOGRAPHIC_SECRET"

[email]
smtp_server = "smtp.gmail.com"
smtp_port = 587
sender_email = "noreply@mtnspec.co.zw"
app_password = "REPLACE_WITH_GMAIL_APP_PASSWORD"

[gee_service_account]
type = "service_account"
project_id = "your-gee-project-id"
private_key_id = "REPLACE_WITH_KEY_ID"
private_key = "-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
client_email = "gee-service@your-gee-project-id.iam.gserviceaccount.com"
client_id = "000000000000000000000"
token_uri = "https://oauth2.googleapis.com/token"

