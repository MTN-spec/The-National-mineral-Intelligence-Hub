[Unit]
Description=The National Mineral Intelligence Hub (mining.mtnspec.co.zw)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/The-National-mineral-Intelligence-Hub
Environment="PATH=/var/www/The-National-mineral-Intelligence-Hub/venv/bin"
ExecStart=/var/www/The-National-mineral-Intelligence-Hub/venv/bin/uvicorn api:app --host 127.0.0.1 --port 8000 --workers 4

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
